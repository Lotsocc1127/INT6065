# 复制为 .env 后填写
# Neon 双连接（见 prisma/schema.prisma）：
#   DATABASE_URL = Pooled 连接串（-pooler 那个），运行时用
#   DIRECT_URL   = Direct 连接串，prisma db push / seed 等 CLI 命令自动使用
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
# 不设置 NEXTAUTH_URL 则按请求 Host 自动推断（localhost / 局域网 IP / 内网穿透均可用）；正式上线填固定域名
# NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

LLM_PROVIDER="deepseek"
# F7 多模型路由：候选链（逗号分隔），失败自动降级；可按任务覆盖，如 LLM_CHAIN_GRADE="deepseek,anthropic"
LLM_CHAIN=""
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ZHIPU_API_KEY=""
ZHIPU_MODEL="glm-4-air"
